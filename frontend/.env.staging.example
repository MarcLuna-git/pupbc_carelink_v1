# Render Staging frontend (pupbc-carelink-staging, branch: staging)
# Render rewrites /api/* -> https://pupbc-carelink-staging-api.onrender.com/api/*
VITE_API_URL=/api
VITE_APP_NAME="PUPBC CareLink (Staging)"
VITE_APP_ENV=staging

# Never put KIOSK_DEVICE_TOKEN in public frontend builds; enter it on the kiosk device UI.
VITE_KIOSK_DEVICE_TOKEN=
