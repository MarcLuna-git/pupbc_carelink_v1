# Render Production frontend (pupbc-carelink-prod, branch: main)
# Render rewrites /api/* -> https://pupbc-carelink-prod-api.onrender.com/api/*
VITE_API_URL=/api
VITE_APP_NAME="PUPBC CareLink"
VITE_APP_ENV=production

# Never put KIOSK_DEVICE_TOKEN in public frontend builds; enter it on the kiosk device UI.
VITE_KIOSK_DEVICE_TOKEN=
