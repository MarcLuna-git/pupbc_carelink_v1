# =============================================================================
# STAGING ENVIRONMENT REFERENCE (Render Staging + Supabase Staging DB)
# =============================================================================
# Reference only. Do NOT commit real secrets. Set sync: false values in the
# Render Dashboard for service: pupbc-carelink-staging-api (branch: staging).
# =============================================================================

APP_NAME="PUPBC CareLink (Staging)"
APP_ENV=staging
APP_KEY=base64:GENERATE_UNIQUE_STAGING_APP_KEY
APP_DEBUG=false
APP_URL=https://pupbc-carelink-staging-api.onrender.com
FRONTEND_URL=https://pupbc-carelink-staging.onrender.com

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# NEW Supabase Staging Database (Session Pooler on port 5432, Singapore)
DB_CONNECTION=pgsql
SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_DATABASE=postgres
SUPABASE_DB_USERNAME=postgres.YOUR_STAGING_PROJECT_REF
SUPABASE_DB_PASSWORD=YOUR_STAGING_SUPABASE_PASSWORD
SUPABASE_DB_SSLMODE=require
SUPABASE_DB_PERSISTENT=true

# Brevo SMTP (port 2525; Render Free blocks 25/465/587)
# EMAIL_TEST_MODE=true reroutes all staging emails to EMAIL_TEST_RECIPIENT.
MAIL_MAILER=smtp
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENT=delivered@resend.dev
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=2525
MAIL_USERNAME=YOUR_BREVO_SMTP_LOGIN
MAIL_PASSWORD=YOUR_BREVO_SMTP_KEY
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=pupbinancarelink@gmail.com
MAIL_FROM_NAME="PUPBC CareLink (Staging)"
MAIL_TIMEOUT=10
NURSE_EMAIL_NOTIFICATIONS=false

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

JWT_SECRET=GENERATE_UNIQUE_STAGING_JWT_SECRET
JWT_TTL=1440
SANCTUM_STATEFUL_DOMAINS=pupbc-carelink-staging.onrender.com
KIOSK_DEVICE_TOKEN=GENERATE_UNIQUE_STAGING_KIOSK_TOKEN
SEED_NURSE_PASSWORD=YOUR_STAGING_NURSE_PASSWORD

SLOT_MAX=10
CLINIC_OPEN_TIME=08:00
CLINIC_CLOSE_TIME=17:00
CLINIC_OPEN_DAYS="Monday to Saturday"
CLINIC_CLOSED_DAYS=Sunday
LUNCH_START=12:00
LUNCH_END=13:00
RATE_LIMIT_PER_MINUTE=60
KIOSK_RATE_LIMIT=30
AUTH_RATE_LIMIT=10

# Clinic assistant (AI chatbot)
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gemma4:31b
OLLAMA_FALLBACK_MODELS=gemma4:31b
OLLAMA_RATE_LIMIT_COOLDOWN=60
OLLAMA_TIMEOUT=30
OLLAMA_MAX_OUTPUT_TOKENS=1024

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemma-4-26b-a4b-it,gemma-4-31b-it
GEMINI_RATE_LIMIT_COOLDOWN=60
GEMINI_TIMEOUT=20
GEMINI_MAX_OUTPUT_TOKENS=1024

CHATBOT_ENABLED=true
CHATBOT_RATE_LIMIT=5
CHATBOT_DAILY_LIMIT=15
CHATBOT_STRUCTURED_REPLIES=true
CHATBOT_TRIAGE_ENABLED=true

CLINIC_EMAIL=pupbinancarelink@gmail.com
