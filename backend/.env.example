# =============================================================================
# LOCALHOST DEVELOPMENT ENVIRONMENT (XAMPP / Local MySQL)
# =============================================================================
# Copy this file to backend/.env for local development.
# This environment is 100% isolated from Render Staging and Render Production.
#
# For hosted references:
#   - Staging (Render + Supabase Staging DB):       backend/.env.staging.example
#   - Production (Render + Supabase Production DB): backend/.env.production.example
# Full guide: docs/RENDER_DEPLOYMENT.md
# =============================================================================

APP_NAME="PUPBC CareLink (Local)"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses local MySQL (XAMPP / Docker).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=carelink
DB_USERNAME=root
DB_PASSWORD=

# Mail is captured in memory locally so no real emails are sent.
MAIL_MAILER=array
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENT=delivered@resend.dev
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=pupbinancarelink@gmail.com
MAIL_FROM_NAME="PUPBC CareLink (Local)"
NURSE_EMAIL_NOTIFICATIONS=false

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

JWT_SECRET=
JWT_TTL=1440
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
KIOSK_DEVICE_TOKEN=local-kiosk-dev-token
# SEED_NURSE_PASSWORD=nurse

SLOT_MAX=10
CLINIC_OPEN_TIME=08:00
CLINIC_CLOSE_TIME=17:00
CLINIC_OPEN_DAYS="Monday to Saturday"
CLINIC_CLOSED_DAYS=Sunday
LUNCH_START=12:00
LUNCH_END=13:00
RATE_LIMIT_PER_MINUTE=60
KIOSK_RATE_LIMIT=30
AUTH_RATE_LIMIT=10

# Clinic assistant (AI chatbot) - leave keys empty locally unless testing AI.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gemma4:31b
OLLAMA_FALLBACK_MODELS=gemma4:31b
OLLAMA_RATE_LIMIT_COOLDOWN=60
OLLAMA_TIMEOUT=30
OLLAMA_MAX_OUTPUT_TOKENS=1024

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemma-4-26b-a4b-it,gemma-4-31b-it
GEMINI_RATE_LIMIT_COOLDOWN=60
GEMINI_TIMEOUT=20
GEMINI_MAX_OUTPUT_TOKENS=1024

CHATBOT_ENABLED=true
CHATBOT_RATE_LIMIT=5
CHATBOT_DAILY_LIMIT=15
CHATBOT_STRUCTURED_REPLIES=true
CHATBOT_TRIAGE_ENABLED=true

CLINIC_EMAIL=pupbinancarelink@gmail.com
